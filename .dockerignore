# Keep the image small: only what the server reads at runtime goes into the build context.
.git
archive
docs
**/node_modules
**/dist
**/__pycache__
**/.pytest_cache
dashboard/samples/report_*.html

# experiments/ holds the research (notebooks, raw data, figures). The server needs only the registered
# models with their scalers, the six cities' data, and the .keras files it lists on the Research page.
# Regenerate this list if config.toml or core/data.py changes (the image's API test fails if a file is missing).
experiments/**
!experiments/**/*.keras
!experiments/03_dayton_duquesne/data/processed/FINAL_MERGED_DAY_LOAD_2006_2016.csv
!experiments/03_dayton_duquesne/data/processed/FINAL_MERGED_DUQ_LOAD_2006_2016.csv
