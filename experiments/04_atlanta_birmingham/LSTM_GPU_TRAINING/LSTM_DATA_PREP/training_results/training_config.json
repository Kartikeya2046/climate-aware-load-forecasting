{
  "seed": 42,
  "lookback_hours": 168,
  "horizon_hours": 1,
  "batch_size": 64,
  "max_epochs": 100,
  "architecture": [
    "LSTM(64, return_sequences=True, L2=1e-4)",
    "Dropout(0.25)",
    "LSTM(32, return_sequences=False, L2=1e-4)",
    "Dropout(0.25)",
    "Dense(16, ReLU, L2=1e-4)",
    "Dense(1, Linear)"
  ],
  "optimizer": "Adam",
  "learning_rate": 0.001,
